  <Item class="VoiceChatService" referent="51">
    <Properties>
      <string name="Name">VoiceChatService</string>
      <bool name="EnableDefaultVoice">true</bool>
    </Properties>
  </Item>
  <Item class="Workspace" referent="52">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">128</int>
      <int name="StreamingTargetRadius">256</int>
    </Properties>
    <Item class="Model" referent="53">
      <Properties>
        <string name="Name">Bicycles</string>
        <bool name="NeedsPivotMigration">false</bool>
      </Properties>
