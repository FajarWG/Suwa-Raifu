					<Item class="Script" referent="RBX49816da7141a4ef89bb53d169094b258">
						<Properties>
							<ProtectedString name="Source"><![CDATA[wait(0.5)
function unanchor (m)
	for _,i in pairs (m:GetChildren()) do
		if i:IsA("BasePart") then
			i:MakeJoints()
			i.Anchored = false
		else
			unanchor(i)
		end
	end
end
unanchor(script.Parent)]]></ProtectedString>
