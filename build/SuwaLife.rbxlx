					<Item class="Script" referent="RBX6d0bb2cb6a624c8ca7c91e569163e889">
						<Properties>
							<ProtectedString name="Source"><![CDATA[wait(0.5)
function unanchor (m)
	for _,i in pairs (m:GetChildren()) do
		if i:IsA("BasePart") then
			i:MakeJoints()
			i.Anchored = false
		else
			unanchor(i)
		end
	end
end
unanchor(script.Parent)]]></ProtectedString>
