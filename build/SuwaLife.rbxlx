									<Z>-1.95278931</Z>
									<R00>-5.08296623e-08</R00>
									<R01>1</R01>
									<R02>-4.37113883e-08</R02>
									<R10>-1</R10>
									<R11>-3.65931001e-08</R11>
									<R12>8.56203997e-13</R12>
									<R20>-8.5975671e-13</R20>
									<R21>4.37113883e-08</R21>
									<R22>1</R22>
								</CoordinateFrame>
								<Ref name="Part0Internal">RBX0bb0bc1204e04e47989976cea47acd19</Ref>
