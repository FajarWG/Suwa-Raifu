					<Item class="Script" referent="RBX44b61e6911f4402ca3becca861a13054">
						<Properties>
							<ProtectedString name="Source"><![CDATA[wait(0.5)
function unanchor (m)
	for _,i in pairs (m:GetChildren()) do
		if i:IsA("BasePart") then
			i:MakeJoints()
			i.Anchored = false
		else
			unanchor(i)
		end
	end
end
unanchor(script.Parent)]]></ProtectedString>
