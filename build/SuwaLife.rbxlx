					<Item class="Script" referent="RBXaacb208d037346beaedb00afe5a417f0">
						<Properties>
							<ProtectedString name="Source"><![CDATA[wait(0.5)
function unanchor (m)
	for _,i in pairs (m:GetChildren()) do
		if i:IsA("BasePart") then
			i:MakeJoints()
			i.Anchored = false
		else
			unanchor(i)
		end
	end
end
unanchor(script.Parent)]]></ProtectedString>
