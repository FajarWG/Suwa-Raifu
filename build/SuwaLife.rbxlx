					<Item class="Script" referent="RBXff6efb29a42a49af9e142007b52915b0">
						<Properties>
							<ProtectedString name="Source"><![CDATA[wait(0.5)
function unanchor (m)
	for _,i in pairs (m:GetChildren()) do
		if i:IsA("BasePart") then
			i:MakeJoints()
			i.Anchored = false
		else
			unanchor(i)
		end
	end
end
unanchor(script.Parent)]]></ProtectedString>
