						<ProtectedString name="Source"><![CDATA[--!strict

export type JapaneseLevel = 'beginner1' | 'beginner2' | 'elementary' | 'intermediate' | 'advanced'

export type Profile = {
	version: number,
	playerId: number,
	profile: {
		displayName: string,
