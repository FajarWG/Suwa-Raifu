									</Properties>
								</Item>
							</Item>
						</Item>
						<Item class="WeldConstraint" referent="RBX5088192c6bb647358a99db69086d6ffa">
							<Properties>
								<CoordinateFrame name="CFrame0">
									<X>-1.90734863e-06</X>
