								<bool name="DefinesCapabilities">true</bool>
								<UniqueId name="HistoryId">73a472927938c0900a99970a00001648</UniqueId>
								<string name="Name">Create Bike Motors</string>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								<UniqueId name="UniqueId">73a472927938c0900a99970a00004716</UniqueId>
